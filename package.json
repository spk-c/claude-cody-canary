{
  "name": "claude-code-canary",
  "version": "2.1.0",
  "description": "Prebuilt Claude Code Canary regression and compatibility CLI (JavaScript distribution)",
  "author": "SLP-DEV1",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "bin": {
    "claude-canary": "dist/v2-cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node scripts/check-dist.mjs",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "anthropic",
    "regression-testing",
    "compatibility-testing",
    "release-testing",
    "version-bisect",
    "github-actions",
    "continuous-integration",
    "developer-tools",
    "plugins",
    "mcp",
    "mcp-server",
    "agent-evals",
    "ai-agent-testing",
    "ai-coding",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spk-c/claude-cody-canary.git"
  },
  "homepage": "https://github.com/spk-c/claude-cody-canary#readme",
  "bugs": {
    "url": "https://github.com/spk-c/claude-cody-canary/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "14.0.3",
    "minimatch": "11.0.3",
    "openpgp": "6.3.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "private": true
}
