{
  "name": "claude-code-canary",
  "version": "2.2.0",
  "description": "Regression and compatibility testing for Claude Code, plugins and MCP servers with reproducible CI evidence",
  "author": "SLP-DEV1",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "bin": {
    "claude-canary": "dist/v2-cli.js",
    "claude-canary-dag": "scripts/dag-orchestrator.mjs",
    "claude-canary-history": "scripts/build-history-index.mjs"
  },
  "files": [
    "dist",
    "schemas",
    "scripts/dag-orchestrator.mjs",
    "scripts/build-history-index.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run version:check && npm run lint && npm test && npm run build && npm run test:security && npm run test:smoke && npm run test:live-safety && npm run test:repro-smoke && npm run test:release-version && npm run test:scaling && npm run test:orchestration && npm run docs:check",
    "build": "tsc -p tsconfig.json",
    "test:security": "node --test tests/security-regressions.test.mjs",
    "test:smoke": "node --test tests/integration-smoke.test.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "live:e2e": "node scripts/live-e2e.mjs core",
    "test:live-safety": "node --test tests/live-fixture-safety.test.mjs",
    "check:dist": "node scripts/check-dist-sync.mjs",
    "test:repro-smoke": "node --test tests/repro-integration.test.mjs",
    "test:release-version": "node --test tests/release-version.test.mjs",
    "shards:merge": "node scripts/verified-shard-combine.mjs",
    "benchmark:shards": "node scripts/benchmark-suite-shards.mjs",
    "test:scaling": "node --test tests/verified-shards.test.mjs",
    "dag:run": "node scripts/dag-orchestrator.mjs",
    "history:index": "node scripts/build-history-index.mjs",
    "test:orchestration": "node --test tests/dag-history.test.mjs"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "anthropic",
    "regression-testing",
    "compatibility-testing",
    "release-testing",
    "version-bisect",
    "github-actions",
    "continuous-integration",
    "developer-tools",
    "plugins",
    "mcp",
    "mcp-server",
    "agent-evals",
    "ai-agent-testing",
    "ai-coding",
    "cli",
    "model-context-protocol",
    "mcp-testing",
    "release-monitoring",
    "plugin-testing",
    "security-testing",
    "reproducible-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spk-c/claude-cody-canary.git"
  },
  "homepage": "https://github.com/spk-c/claude-cody-canary#readme",
  "bugs": {
    "url": "https://github.com/spk-c/claude-cody-canary/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "14.0.3",
    "minimatch": "11.0.3",
    "openpgp": "6.3.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openpgp/web-stream-tools": "0.3.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
